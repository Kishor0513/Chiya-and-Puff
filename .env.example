# Database (PostgreSQL on Neon.tech)
# ── Local dev ─────────────────────────────────────────────────────────────
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chiya_and_puff"
# ── Neon (production / hosted) ────────────────────────────────────────────
# Runtime (Vercel -> Neon): use the POOLED connection string (has "-pooler" in
# the host) so serverless functions share connections:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# One-time schema push + seed: run from your own machine with the DIRECT
# (non-pooler) connection string, then switch back to pooled for runtime:
# npx prisma db push && node prisma/seed.js
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chiya_and_puff"

# ─── Authentication ──────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET="replace-this-with-a-strong-random-secret"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
